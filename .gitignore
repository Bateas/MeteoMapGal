# This repository is PUBLIC, so this file is an ALLOWLIST: everything at the
# top level is ignored unless it is named below. A file nobody planned for
# (notes, exports, documents, an assistant's scratch work) stays out by
# default instead of being published by one careless `git add`. Adding a path
# here is a deliberate change that shows up in review. Documentation and
# private notes live in folders OUTSIDE this one.
/*
!/.env.example
!/.githooks/
!/.github/
!/.gitignore
!/.npmrc
!/LICENSE
!/README.md
!/assets/
!/eslint.config.js
!/hero.jpg
!/index.html
!/ingestor/
!/knip.json
!/nginx.conf
!/package-lock.json
!/package.json
!/public/
!/src/
!/tools/
!/tsconfig.app.json
!/tsconfig.json
!/tsconfig.node.json
!/vite.config.ts
!/widget.html

# tools/: only the scripts the deploy and the gates run.
/tools/*
!/tools/meteomap-update.sh
!/tools/security-scan.sh
!/tools/typecheck-gate.sh

# Inside the allowed folders, still never:
.env
.env.*
!.env.example
*.local
*.log
node_modules/
dist/
dist-ssr/
*.tsbuildinfo
__pycache__/
*.pyc
.DS_Store
# notes and documents: only the README is published
*.md
!/README.md
CLAUDE.md
.claude/
