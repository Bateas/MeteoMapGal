# MeteoMapGal Ingestor — Environment Variables
# Copy to .env and fill in your values

# AEMET API key (required)
AEMET_API_KEY=your_aemet_api_key_here

# Weather Underground API key
# This is IBM's PUBLIC key, embedded in wunderground.com page source.
# Extracted from their site, not a credential. Hardcoded fallback exists in code
# (removing it broke discovery — see commits 9f07f33 → 58ea5ca). Override here if needed.
WU_API_KEY=e1f10a1e78da46f5b10a1e78da96f525

# SkyX auth token (PUBLIC — extracted from their web client, not a private credential)
# Optional: omit to use the in-code fallback. Single Cesantes station.
# SKYX_AUTH=a21bd737-a714-4a5c-9b08-e7d3d2693a51

# TimescaleDB connection
DB_HOST=your_db_host
DB_PORT=5432
DB_NAME=meteomapgal
DB_USER=meteomap_app
DB_PASSWORD=your_secure_password_here

# Observatorio Costeiro da Xunta API key (for buoy data)
# Server-side only (never a VITE_ variable)
OBSCOSTEIRO_API_KEY=your_obscosteiro_api_key_here

# NASA FIRMS Active Fire API key (free, register at:
# https://firms.modaps.eosdis.nasa.gov/api/map_key/)
# Used for the /api/v1/firms proxy that powers the active-fire overlay.
# The key + bounding box (Galicia + buffer) are locked server-side; the
# proxy cannot be used to query other regions.
FIRMS_API_KEY=your_firms_map_key_here

# Webcam vision analysis via Ollama (default: disabled)
# Must be the exact string "true" to enable — any other value, or leaving it
# out, silently disables the whole webcam pipeline (no readings, no fog
# evidence from cameras). Requires a reachable Ollama instance, below.
WEBCAM_VISION_ENABLED=false

# Ollama endpoint + model used by the webcam vision analyzer.
# Only read when WEBCAM_VISION_ENABLED=true.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=moondream

# Verbose ingestor logging (default: off). Set to "true" to enable log.debug
# output when investigating a specific issue.
# INGESTOR_DEBUG=false

# Web Push VAPID keys (PWA lightning-safety notifications)
# Generate ONCE outside the repo: npx web-push generate-vapid-keys
# Missing/invalid keys => push feature disabled with a single startup warn
# (never a crash). VAPID_SUBJECT must be a mailto: contact URL.
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:your_contact_email_here

# Polling interval in minutes (default: 5)
POLL_INTERVAL_MIN=5

# Station re-discovery interval in minutes (default: 60)
DISCOVER_INTERVAL_MIN=60

# ── Automation backend (Telegram alerts + daily summary) ──
# Both hooks are reached from the ingestor directly; the public reverse proxy
# only forwards the feedback hook. Never a VITE_ variable.
N8N_ALERT_WEBHOOK=http://your_n8n_host:5678/webhook/meteomap-alert
N8N_SUMMARY_WEBHOOK=http://your_n8n_host:5678/webhook/meteomap-summary
# Shared secret sent as X-Webhook-Secret on every alert/summary POST. Set the
# same value as Header Auth on both webhook nodes: without it the hooks accept
# anything that can reach them. This is the second belt behind the proxy.
N8N_WEBHOOK_SECRET=your_shared_secret_here
