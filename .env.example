# Private API keys (AEMET, MeteoSIX, Observatorio Costeiro) do NOT go here.
# Anything prefixed VITE_ is compiled into the public JS bundle. They live
# server-side only, in ingestor/.env — see ingestor/.env.example.

# ── AIS Ship Tracking (aisstream.io — free) ──
# VITE_AISSTREAM_API_KEY=your_aisstream_api_key_here

# ── Webcam Vision (Beaufort estimation via LLM) ──
# Enable/disable vision analysis
# VITE_VISION_ENABLED=true
# Provider: lmstudio | deepseek | ollama
# VITE_VISION_PROVIDER=lmstudio
# Override defaults:
# VITE_VISION_BASE_URL=http://localhost:1234/v1
# VITE_VISION_MODEL=local-model
# VITE_VISION_API_KEY=
